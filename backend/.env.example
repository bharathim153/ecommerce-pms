APP_NAME="Product Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_pms
DB_USERNAME=pms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Use MAIL_MAILER=brevo-api (HTTPS) where outbound SMTP is blocked, e.g. Railway Hobby/Trial.
BREVO_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Must exceed PDF_JOB_TIMEOUT or long exports get re-delivered mid-run
DB_QUEUE_RETRY_AFTER=7500
PDF_CHROME_PATH=google-chrome
PDF_CHUNK_SIZE=20
PDF_JOB_TIMEOUT=7200

# --- Payments (use TEST / SANDBOX credentials only in development) ---
PAYMENT_CURRENCY=USD
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Email campaigns ---
# Mailgun:  MAIL_MAILER=mailgun, MAILGUN_DOMAIN, MAILGUN_SECRET, MAILGUN_ENDPOINT=api.mailgun.net
# Amazon SES (SMTP): MAIL_MAILER=smtp, MAIL_HOST=email-smtp.<region>.amazonaws.com, MAIL_PORT=587, MAIL_USERNAME/MAIL_PASSWORD = SES SMTP credentials
CAMPAIGN_CHUNK_SIZE=25
CAMPAIGN_EMAILS_PER_MINUTE=600
CAMPAIGN_FOOTER_ADDRESS="Your Company, 123 Main Street, City, Country"
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# --- Security ---
# API tokens expire after this many minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
# Production seeding REQUIRES these (the seeder refuses default/example credentials):
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Behind a reverse proxy / PaaS (Railway, Render, nginx, load balancer) ---
# Trust X-Forwarded-* so https is detected. '*' is fine when the app is only reachable through the platform's proxy.
TRUSTED_PROXIES=
